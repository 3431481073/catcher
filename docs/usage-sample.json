// ============================================================================
//  App 使用时长：一条真实数据（usage_records 的一行）
//
//  来源：D:\MyProject\catcher\backend\dist\data\app.db
//        取自 2026-10-12，是**一段真实的手机使用**（不是造出来的样例）。
//
//  🔴🔴 这个文件是 **JSONC（带注释的 JSON）**，【不是合法 JSON】。
//        `jq` / `python -m json.tool` / `JSON.parse` 都会拒绝它。
//        **机器要读的话：删掉所有以 // 开头的行**，剩下的就是标准 JSON
//        （已实测：去掉注释行后 `json.loads()` 通过）。
//        ⚠️ 每条注释都写在自己那个字段的**后面**，所以**最后一个字段 `updated_at` 没有逗号**
//           —— 往里加字段时记得给前一个补上。
//        之所以这么写：JSON 语法本身不支持注释，而这份文件的读者是人和 agent。
//        （`usage-fields.md` §2.1 有同样内容，且是纯 Markdown。）
//
//  字段语义见 docs/usage-fields.md §2.1  ·  怎么读见 docs/usage-read.md
// ============================================================================

{
  "id": "usage_cbe4ffc4da6740cd8dd9d3bd9887d66d",
  //    行标识。格式 `usage_` + 32 位十六进制。**对消费者没有意义**，只是唯一标识。
  //    ⚠️ 同一段被重复上报时走 `INSERT ... ON CONFLICT DO UPDATE`，
  //       而 `DO UPDATE SET` 里**没有 `id`** ⇒ **覆盖时 id 保持不变**（新生成的 uuid 被丢弃）。
  //       ⇒ **不要拿 id 当"这行变没变"的判据**，那要看 end_time / updated_at。

  "device_id": "2b9067a95b4d2d34",
  //    哪台设备。Android ANDROID_ID 的 SHA256 **前 16 位十六进制**。
  //    16 位十六进制 = 64 bit。同一台手机卸载重装（签名不变）**不变**。
  //    目前库里只有这一台。

  "package_name": "com.example.clip",
  //    哪个 App —— Android 包名。**这是跟 App 对应的稳定标识，消费方请用它做键**。
  //    这一条是「剪藏」自己（com.example.clip）。

  "app_label": "剪藏",
  //    App 的可读名（中文/人类可读）。**可空**。
  //    只有"手机上报的那一批事件里出现过这个包名"时才会有值 —— 正常都有，为空的情况见 usage-fields.md §6.4。
  //    显示给人看时用它；**为空则回退到 package_name**。

  "start_time": "2026-10-11T19:34:14.207000Z",
  //    这一段从什么时候开始。
  //    ISO8601 · **UTC**（结尾 Z）· **微秒精度（6 位）** · **定宽 29 字符**。
  //    🔴 定宽 ⇒ 可以直接当字符串比较大小，不用解析。
  //    🔴 这是 **UTC**：19:34Z 对 UTC+8 的用户是 **10-12 的 03:34** —— 换算见 usage-read.md §2.1。

  "end_time": "2026-10-11T19:34:56.620000Z",
  //    这一段到什么时候结束。格式同 start_time。
  //    ⚠️ 微秒是**补零到 6 位**的：这里必须写 `.620000Z` 而不是 `.620Z`（抄的时候容易漏）。

  "duration_seconds": 42,
  //    这一段持续了多少秒。**INTEGER**。
  //    = (end_time − start_time) **向下取整到整秒**。
  //    本条：(19:34:56.620 − 19:34:14.207) = 42.413 秒 ⇒ 存 **42**（少了 0.413 秒）。
  //    ⚠️ 逐段求和会累积这个误差（一天上千段最多少十几分钟）—— 见 usage-fields.md §6.2。

  "created_at": "2026-10-11T19:35:35.569000Z",
  //    这行**是什么时候被写进库的**（不是使用时间）。ISO8601 UTC 微秒。
  //    本条：使用发生在 19:34，**19:35:35 才落库**（手机攒了一批一起上报）。

  "updated_at": "2026-10-11T19:35:46.305000Z"
  //    ↑ 🔴 **最后这个字段【没有逗号】** —— 往这个对象里加字段时，别忘了给前一个补上逗号。
  //    这行**最后一次被改写**的时间。
  //    ⚠️ 同一段被重复上报时会**原地覆盖**（唯一键 ux_usage_seg 命中），
  //       此时 updated_at 会变、而 start_time/end_time 可能不变。
  //       实测过一次整库 94% 的行被重写（手机侧重传了整个 7 天）—— 见 usage-fields.md §6.3。
  //    ⚠️ **判断"要不要重新拉"不要看它。**
  //    🔴 **本条就是个活例子**：取样瞬间它是 `19:35:35.569Z`（= created_at），
  //       几分钟后复查已经变成 `19:35:46.305Z` —— **这一段被覆盖过一次**，
  //       而 start_time / end_time / duration_seconds **一个字都没变**。
}
